# .deb file installer (bz-deb-installer.c, bz-deb-install-dialog.*)
msgid "Install Package"
msgstr "Pasang Paket"

msgid "Install Older Version"
msgstr "Pasang Versi Lama"

#, c-format
msgid "Version %s is installed"
msgstr "Versi %s sudah terpasang"

#, c-format
msgid "A newer version, %s, is installed"
msgstr "Versi yang lebih baru, %s, sudah terpasang"

msgid "This version is installed"
msgstr "Versi ini sudah terpasang"

msgid "Cannot Open This Package"
msgstr "Paket Ini Tidak Dapat Dibuka"

msgid "This Package Cannot Be Installed"
msgstr "Paket Ini Tidak Dapat Dipasang"

msgid "The file is damaged, or it is not a software package for this system."
msgstr "Berkas rusak, atau bukan paket perangkat lunak untuk sistem ini."

msgid "Other packages it needs are missing, or conflict with the installed system."
msgstr "Paket lain yang dibutuhkan tidak tersedia, atau berbenturan dengan sistem yang terpasang."

msgid "Installing packages needs PackageKit, which is not installed."
msgstr "Pemasangan paket membutuhkan PackageKit, yang belum terpasang."

msgid "Installation failed"
msgstr "Pemasangan gagal"

msgid "Technical Details"
msgstr "Rincian Teknis"

msgid "Only install packages you trust"
msgstr "Pasang hanya paket yang Anda percayai"

msgid ""
"This package does not come from your system's software sources, so its "
"origin cannot be checked. It can change any part of the system."
msgstr ""
"Paket ini tidak berasal dari sumber perangkat lunak sistem Anda, sehingga "
"asal-usulnya tidak dapat diperiksa. Paket ini dapat mengubah bagian mana pun "
"dari sistem."

msgid "Restart Now"
msgstr "Mulai Ulang Sekarang"

msgid "Restart the computer to finish the installation."
msgstr "Mulai ulang komputer untuk menyelesaikan pemasangan."

msgid "Package"
msgstr "Paket"

msgid "Version"
msgstr "Versi"

msgid "Installed Version"
msgstr "Versi Terpasang"

msgid "Website"
msgstr "Situs Web"

msgid "Description"
msgstr "Deskripsi"

#, c-format
msgid "Also installs or updates %u other package"
msgid_plural "Also installs or updates %u other packages"
msgstr[0] "Juga memasang atau memperbarui %u paket lain"

#, c-format
msgid "Removes %u package"
msgid_plural "Removes %u packages"
msgstr[0] "Menghapus %u paket"

# GNOME Extensions tab (bz-gnome-extensions*.c/.blp, bz-gnome-extension-dialog.*,
# bz-window.blp H17); see ai-patches/PLAN.md §13.

#. Translators: the tab listing GNOME Shell extensions
msgid "Extensions"
msgstr "Ekstensi"

msgid "Enabled"
msgstr "Aktif"

msgid "Disabled"
msgstr "Nonaktif"

#. Translators: a GNOME Shell extension that does not support this GNOME version
msgid "Incompatible"
msgstr "Tidak Kompatibel"

msgid "Installing…"
msgstr "Memasang…"

msgid "Enabling…"
msgstr "Mengaktifkan…"

msgid "Disabling…"
msgstr "Menonaktifkan…"

msgid "This extension failed to start."
msgstr "Ekstensi ini gagal dijalankan."

msgid "This extension does not support this version of GNOME."
msgstr "Ekstensi ini tidak mendukung versi GNOME ini."

#, c-format
msgid "GNOME Shell could not do this: %s"
msgstr "GNOME Shell tidak dapat melakukannya: %s"

msgid "GNOME Shell could not do this."
msgstr "GNOME Shell tidak dapat melakukannya."

msgid "GNOME Shell is not running."
msgstr "GNOME Shell tidak berjalan."

msgid "No Extensions Installed"
msgstr "Belum Ada Ekstensi Terpasang"

msgid "No Extensions Found"
msgstr "Ekstensi Tidak Ditemukan"

msgid "Extensions you install appear here."
msgstr "Ekstensi yang Anda pasang akan muncul di sini."

msgid "Try a different search."
msgstr "Coba kata pencarian lain."

msgid "GNOME Shell extensions are turned off"
msgstr "Ekstensi GNOME Shell dimatikan"

msgid "_Turn On"
msgstr "_Nyalakan"

msgid "Search Extensions"
msgstr "Cari Ekstensi"

msgid "Sort"
msgstr "Urutkan"

#. Translators: sort GNOME Shell extensions by last update
msgid "Recent"
msgstr "Terbaru"

msgid "Could Not Reach extensions.gnome.org"
msgstr "Tidak Dapat Menghubungi extensions.gnome.org"

msgid "Check your internet connection and try again."
msgstr "Periksa koneksi internet Anda, lalu coba lagi."

msgid "_Try Again"
msgstr "_Coba Lagi"

#. Translators: %s is the name of the person who made a GNOME Shell extension
#, c-format
msgid "by %s"
msgstr "oleh %s"

msgid "The extension is deleted from this computer."
msgstr "Ekstensi ini akan dihapus dari komputer ini."

msgid "_Install"
msgstr "_Pasang"

msgid "Settings"
msgstr "Pengaturan"

msgid ""
"Extensions run inside GNOME Shell with full access to your session. Only "
"install extensions you trust."
msgstr ""
"Ekstensi berjalan di dalam GNOME Shell dengan akses penuh ke sesi Anda. "
"Pasang hanya ekstensi yang Anda percayai."

