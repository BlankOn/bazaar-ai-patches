msgstr "Disediakan oleh %s"

msgid " · "
msgstr " · "

msgid "System Is Up to Date"
msgstr "Sistem Sudah Mutakhir"

msgid "Will be removed"
msgstr "Akan dihapus"

msgid "This package will be removed"
msgstr "Paket ini akan dihapus"

#, c-format
msgid "New package, %s"
msgstr "Paket baru, %s"

msgid "Security update"
msgstr "Pembaruan keamanan"

msgid "Install Updates Now?"
msgstr "Pasang Pembaruan Sekarang?"

msgid "Updating the running system can make open apps misbehave until they are restarted. Installing updates on restart is safer."
msgstr "Memperbarui sistem yang sedang berjalan dapat membuat aplikasi yang terbuka berperilaku tidak semestinya hingga dimulai ulang. Memasang pembaruan saat mulai ulang lebih aman."

msgid "_Cancel"
msgstr "_Batal"

msgid "_Install Now"
msgstr "_Pasang Sekarang"

msgid "View Updates"
msgstr "Lihat Pembaruan"

msgid "Security Updates Available"
msgstr "Pembaruan Keamanan Tersedia"

msgid "Updates Available"
msgstr "Pembaruan Tersedia"

msgid "System Updates"
msgstr "Pembaruan Sistem"

msgid "System Update Failed"
msgstr "Pembaruan Sistem Gagal"

msgid "Dismiss"
msgstr "Tutup"

msgid "Updates Ready to Install"
msgstr "Pembaruan Siap Dipasang"

msgid "System updates will be installed the next time the computer restarts"
msgstr "Pembaruan sistem akan dipasang saat komputer dimulai ulang berikutnya"

msgid "C_ancel Update"
msgstr "B_atalkan Pembaruan"

msgid "_Restart Now"
msgstr "_Mulai Ulang Sekarang"

msgid "Restart Required"
msgstr "Perlu Mulai Ulang"

msgid "Restart the computer to finish applying system updates"
msgstr "Mulai ulang komputer untuk menyelesaikan penerapan pembaruan sistem"

msgid "Check for Updates"
msgstr "Periksa Pembaruan"

msgid "Restart & _Update"
msgstr "Mulai Ulang & _Perbarui"

msgid "Download updates now and install them on the next restart"
msgstr "Unduh pembaruan sekarang dan pasang saat mulai ulang berikutnya"

msgid "Install Now Without Restarting"
msgstr "Pasang Sekarang Tanpa Mulai Ulang"

